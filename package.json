{
  "name": "little-pudding-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "models:optimize": "node tools/optimize-models.mjs",
    "art:shop": "node tools/fetch-shop-art.mjs",
    "test:negative": "node tools/check-negative-controls.mjs",
    "pacing": "vitest run --config tools/pacing/vitest.config.ts --root . --reporter=verbose --silent=false",
    "playtest": "node tools/playtest/opening.mjs && node tools/playtest/taps.mjs && node tools/playtest/layout.mjs && node tools/playtest/midgame.mjs && node tools/playtest/offline.mjs && node tools/playtest/shop-click.mjs",
    "smoke:live": "node tools/smoke-live.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "meshoptimizer": "^1.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
